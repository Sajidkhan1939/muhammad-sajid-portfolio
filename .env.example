# Public canonical site URL, used by metadata and sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMTP server details from your email provider
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=replace-with-your-smtp-app-password

# Sender must be permitted by your SMTP provider; destination is your inbox
SMTP_FROM_EMAIL=verified-sender@example.com
CONTACT_TO_EMAIL=replace-with-your-email@example.com
